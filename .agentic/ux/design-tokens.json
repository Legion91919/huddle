{
  "$description": "Huddle design tokens. Calm, trustworthy, mobile-first. One accent (teal). Ochre is reserved for the logo mark. All text pairs >= 4.5:1 (checked in decision.md).",
  "color": {
    "bg": "#f6f3ee",
    "surface": "#ffffff",
    "surface-sunk": "#efeae2",
    "border": "#d9d1c4",
    "text": "#1b2a27",
    "muted": "#53625e",
    "accent": "#0d6b58",
    "accent-strong": "#09503f",
    "on-accent": "#ffffff",
    "accent-soft": "#dcefe9",
    "brand-mark": "#b8650f",
    "success": "#17714a",
    "success-soft": "#e1f2e8",
    "warning": "#8a5300",
    "warning-soft": "#fbefd9",
    "danger": "#b42318",
    "danger-soft": "#fde8e6",
    "focus": "#1f5fbf"
  },
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "numeric": "font-variant-numeric: tabular-nums",
    "size": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "28px", "display": "36px" },
    "weight": { "regular": 400, "medium": 560, "bold": 700 },
    "line-height": { "tight": 1.2, "body": 1.5 }
  },
  "space": { "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "48px" },
  "radius": { "sm": "6px", "md": "12px", "lg": "20px", "pill": "999px" },
  "shadow": { "card": "0 1px 2px rgba(27,42,39,.06), 0 4px 16px rgba(27,42,39,.06)" },
  "layout": { "max-width": "720px", "touch-target": "44px" }
}
